---
import Layout from '../../../layouts/Layout.astro';
import { PARTNERS } from '../../../data/partners';

const partners = PARTNERS.filter((p) => p.kind === 'partner');
const projects = PARTNERS.filter((p) => p.kind === 'project');
---

<Layout
  title="Support an Indian Partner | Global Hope India"
  description="Give directly to the Indian leaders Global Hope India walks alongside. Choose a partner and give monthly or one-time — secure and tax-deductible."
>
  <section class="relative min-h-[36vh] flex items-end overflow-hidden">
    <div class="absolute inset-0 bg-[#1D1C1C]" style="background-image:url('https://assets.spiritmediapublishing.com/images/ghi-about-hero.webp');background-size:cover;background-position:center;"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/35 to-transparent"></div>
    <div class="relative z-10 container mx-auto px-6 lg:px-12 pb-10 pt-36">
      <p class="text-[#1d803f] font-semibold text-sm uppercase tracking-widest mb-3">Partners &amp; Projects</p>
      <h1 style="color:white!important;" class="max-w-3xl font-bold text-[28px] md:text-[36px] lg:text-[46px] leading-[1.2]">Give directly to the people doing the work</h1>
      <p class="mt-4 text-white/75 text-lg max-w-2xl">Every partner below serves their own community in India. Choose one and your gift is designated to them.</p>
    </div>
  </section>

  <section class="section bg-[#F8F9F3] py-14">
    <div class="container mx-auto max-w-6xl px-6">
      <h2 class="text-[#1D1C1C] font-bold text-2xl mb-6">Indian Partners</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {partners.map((p) => (
          <a href={`/give/partners/${p.slug}/`} class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-stone-200">
            <img src={p.image} alt={p.name} width="400" height="225" loading="lazy" class="w-full h-44 object-contain bg-[#F1EFE9]" />
            <div class="p-5">
              <p class="text-[#1D1C1C] font-bold">{p.name}</p>
              <p class="text-[#595959] text-sm mt-1">{p.tagline}</p>
              <span class="text-[#1d803f] text-xs font-semibold mt-3 inline-block group-hover:underline">Support &rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="text-[#1D1C1C] font-bold text-2xl mt-14 mb-6">Projects</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((p) => (
          <a href={`/give/partners/${p.slug}/`} class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-stone-200">
            <img src={p.image} alt={p.name} width="400" height="225" loading="lazy" class="w-full h-44 object-contain bg-[#F1EFE9]" />
            <div class="p-5">
              <p class="text-[#1D1C1C] font-bold">{p.name}</p>
              <p class="text-[#595959] text-sm mt-1">{p.tagline}</p>
              <span class="text-[#1d803f] text-xs font-semibold mt-3 inline-block group-hover:underline">Support &rarr;</span>
            </div>
          </a>
        ))}
      </div>

      <p class="text-center text-[#595959] text-sm mt-12 max-w-2xl mx-auto">
        Prefer we direct it? <a href="/give/" class="text-[#06038D] font-semibold hover:underline">Give where most needed</a> and we'll put it toward the greatest current need.
      </p>
    </div>
  </section>
</Layout>
